pipeline {
    agent {
        label 'UI-Node'
    }
    environment {
        DOCKER_IMAGE = "devsecopstrainer/cicd-react-ui"
        IMAGE_TAG    = "${BUILD_NUMBER}"
        IMAGE_NAME   = "${DOCKER_IMAGE}:${IMAGE_TAG}"
    }
    stages {
        stage('Checkout-Source Code') {
            steps {
				dir('git-repo') {
					git branch: 'main', url: 'https://github.com/devsecopstrainer/cicd-react-ui.git'
				}
			}
        }
        stage('Checkout-Docker File') {
            steps {
                dir('docker-repo') {
				    git branch: 'main', url: 'https://github.com/devsecopstrainer/cicd-jenkins-docker.git'
				}
            }
        }
        stage('Docker build') {
            steps {
                sh 'docker build -f docker-repo/Dockerfile-UI -t devsecopstrainer/cicd-react-ui:${BUILD_NUMBER} git-repo'
            }
        }
        stage('Docker Push') {
            steps {
                //sh 'docker push devsecopstrainer/cicd-react-ui:${BUILD_NUMBER}'
				echo 'Hello World'
            }
        }
    }
}
