pipeline {
    agent {
        label 'MS-Node'
    }
    environment {
        DOCKER_IMAGE = "devsecopstrainer/cicd-react-ui"
        IMAGE_TAG    = "${BUILD_NUMBER}"
        IMAGE_NAME   = "${DOCKER_IMAGE}:${IMAGE_TAG}"
    }
    stages {
        stage('Checkout-Source Code') {
            steps {
				dir('git-repo') {
					git branch: 'main', url: 'https://github.com/devsecopstrainer/cicd-react-ui.git'
				}
			}
        }
        stage('Checkout-Docker File') {
            steps {
                dir('docker-repo') {
				    git branch: 'main', url: 'https://github.com/devsecopstrainer/cicd-jenkins-docker.git'
				}
            }
        }
        stage('Docker build') {
            steps {
                sh 'docker build -f docker-repo/Dockerfile-UI -t $IMAGE_NAME git-repo'
            }
        }
        stage('Docker Push') {
            steps {
                sh 'docker push $IMAGE_NAME'
            }
        }
        stage('K8S Deploy') {
            steps {
                dir('k8s-repo') {
				    git branch: 'main', url: 'https://github.com/devsecopstrainer/project-kubernetes-yml.git'
				    sh """
				    sed -i 's|image: ${DOCKER_IMAGE}:.*|image: ${IMAGE_NAME}|' ui/ui-deployment.yaml
				    kubectl apply -f ui/ui-deployment.yaml
				    """
				}
            }
        }
    }
}
